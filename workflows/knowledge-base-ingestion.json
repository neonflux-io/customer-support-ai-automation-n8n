    {
      "parameters": {},
      "id": "kb-manual",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        260
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Extract and normalize documents from the webhook body. If no documents are\n// provided, fall back to fetching from KB_SOURCE_URL (or the payload source_url).\nconst input = $input.first().json;\nconst payload = (input && input.body && typeof input.body === 'object' && !Array.isArray(input.body))\n  ? input.body\n  : input;\n\nconst rawDocs = Array.isArray(payload && payload.documents) ? payload.documents : [];\nconst docs = rawDocs\n  .filter(d => d && typeof (d.content || d.text) === 'string' && String(d.content || d.text).trim())\n  .map((d, i) => ({\n    title: String(d.title || payload.title || ('Document ' + (i + 1))).trim().slice(0, 512),\n    source: String(d.source || payload.source || 'webhook').slice(0, 255),\n    category: String(d.category || payload.category || 'general').slice(0, 100),\n    content: String(d.content || d.text).trim(),\n    metadata: (d.metadata && typeof d.metadata === 'object' && !Array.isArray(d.metadata)) ? d.metadata : {}\n  }));\n\nconst use_fetch = docs.length === 0;\nconst fetch_url = String((payload && payload.source_url) || process.env.KB_SOURCE_URL || '');\nreturn [{ json: { docs, use_fetch, fetch_url } }];"
      },
      "id": "kb-extract",
      "name": "Extract & Normalize Documents",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "id": "cond-kb-use-fetch",
              "leftValue": "={{ $json.use_fetch }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "combinator": "and"
        },
        "options": {}
      },
      "id": "kb-has-docs",
      "name": "Has Documents?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        520,
        0
      ]
    },
    {

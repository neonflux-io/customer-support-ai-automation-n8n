        "url": "={{ $json.fetch_url }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "kb-fetch",
      "name": "Fetch Knowledge Source",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        260
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Parse an arbitrary remote response (array, {documents: [...]}, {data: [...]})\n// into the normalized document shape.\nconst res = $input.first().json;\nlet data = res && res.body && typeof res.body === 'object' ? res.body : res;\nif (typeof data === 'string') { try { data = JSON.parse(data); } catch (e) { data = null; } }\n\nlet arr = Array.isArray(data) ? data\n  : (Array.isArray(data && data.documents) ? data.documents\n  : (Array.isArray(data && data.data) ? data.data : []));\n\nconst docs = arr\n  .filter(d => d && typeof (d.content || d.text) === 'string' && String(d.content || d.text).trim())\n  .map((d, i) => ({\n    title: String(d.title || d.name || ('Fetched ' + (i + 1))).trim().slice(0, 512),\n    source: String(d.source || 'remote').slice(0, 255),\n    category: String(d.category || 'general').slice(0, 100),\n    content: String(d.content || d.text).trim(),\n    metadata: (d.metadata && typeof d.metadata === 'object' && !Array.isArray(d.metadata)) ? d.metadata : {}\n  }));\n\nreturn [{ json: { docs } }];"
      },
      "id": "kb-parse-fetched",
      "name": "Parse Fetched Documents",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        260
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Expand the docs array into one item per document so downstream nodes\n// process each document independently.\nconst docs = $input.first().json.docs || [];\nreturn docs.map(d => ({ json: d }));"
      },
      "id": "kb-expand",
      "name": "Expand Documents",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO documents (title, source, category, content, metadata) VALUES ($1, $2, $3, $4, $5::jsonb) ON CONFLICT (title, source) DO UPDATE SET content = EXCLUDED.content, category = EXCLUDED.category, metadata = EXCLUDED.metadata, updated_at = now() RETURNING id, title, source, category, content;",
        "queryParameters": {
          "parameters": [
            {
              "value": "={{ $json.title }}"
            },
            {
              "value": "={{ $json.source }}"
            },
            {
              "value": "={{ $json.category }}"
            },
            {
              "value": "={{ $json.content }}"
            },
            {
              "value": "={{ JSON.stringify($json.metadata) }}"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_POSTGRES_CREDENTIAL_ID",
          "name": "Postgres"
        }
      },
      "id": "kb-insert-docs",
      "name": "Insert Documents",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        1560,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Deterministic recursive character chunking with paragraph/word boundary\n// awareness. Produces one item per chunk for the vector store upsert.\nfunction uuid() {\n  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {\n    const r = Math.random() * 16 | 0;\n    const v = c === 'x' ? r : ((r & 0x3) | 0x8);\n    return v.toString(16);\n  });\n}\n\nconst chunkSize = Number(process.env.KB_CHUNK_SIZE || 800);\nconst chunkOverlap = Number(process.env.KB_CHUNK_OVERLAP || 100);\nconst out = [];\n\nfor (const doc of $input.all().map(i => i.json)) {\n  const text = String(doc.content || '');\n  let start = 0;\n  let index = 0;\n  while (start < text.length) {\n    let end = Math.min(start + chunkSize, text.length);\n    if (end < text.length) {\n      let cut = text.lastIndexOf('\\n\\n', end);\n      if (cut < start + 40) cut = text.lastIndexOf('\\n', end);\n      if (cut < start + 40) cut = text.lastIndexOf(' ', end);\n      if (cut >= start + 40 && cut <= end) end = cut;\n    }\n    const chunkText = text.slice(start, end).trim();\n    if (chunkText) {\n      out.push({ json: {\n        id: uuid(),\n        chunk_text: chunkText,\n        metadata: {\n          document_id: doc.id,\n          title: doc.title,\n          source: doc.source,\n          category: doc.category,\n          chunk_index: index\n        }\n      } });\n    }\n    if (end >= text.length) break;\n    start = Math.max(0, end - chunkOverlap);\n    index += 1;\n  }\n}\n\nreturn out;"
      },

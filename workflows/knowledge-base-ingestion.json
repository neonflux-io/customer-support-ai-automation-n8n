        "jsCode": "const docs = $('Insert Documents').all().length;\nconst chunks = $('Chunk & Prepare').all().length;\nreturn [{ json: { success: true, documents_ingested: docs, chunks_created: chunks, chunks_embedded: chunks } }];"

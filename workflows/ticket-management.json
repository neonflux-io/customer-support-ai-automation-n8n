    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH updated AS (UPDATE tickets SET subject = COALESCE(NULLIF($2, ''), subject), priority = COALESCE(NULLIF($3, ''), priority), status = COALESCE(NULLIF($4, ''), status), ai_summary = COALESCE(NULLIF($5, ''), ai_summary), resolution = COALESCE(NULLIF($6, ''), resolution), last_message = COALESCE(NULLIF($7, ''), last_message), updated_at = now() WHERE id = NULLIF($1, '')::uuid RETURNING ticket_number, id, status, priority, updated_at) SELECT * FROM updated UNION ALL SELECT 'NONE', NULL, NULL, NULL, NULL WHERE NOT EXISTS (SELECT 1 FROM updated);",
        "queryParameters": {
          "parameters": [
            { "value": "={{ $json.ticket_id }}" },
            { "value": "={{ $json.subject }}" },
            { "value": "={{ $json.priority }}" },
            { "value": "={{ $json.status }}" },
            { "value": "={{ $json.ai_summary }}" },
            { "value": "={{ $json.resolution }}" },

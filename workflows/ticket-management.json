        "query": "WITH updated AS (UPDATE tickets SET status = 'resolved', resolution = COALESCE(NULLIF($2, ''), resolution), resolved_at = now(), updated_at = now() WHERE id = NULLIF($1, '')::uuid RETURNING ticket_number, id, status, resolved_at) SELECT * FROM updated UNION ALL SELECT 'NONE', NULL, NULL, NULL WHERE NOT EXISTS (SELECT 1 FROM updated);",

    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Parse and validate the ticket management request.\n// Actions: create, update, assign, resolve, reopen, get, list.\nconst input = $input.first().json;\nconst body = (input && input.body && typeof input.body === 'object' && !Array.isArray(input.body))\n  ? input.body\n  : input;\n\nconst action = String((body && body.action) || '').trim().toLowerCase();\nconst allowed = ['create', 'update', 'assign', 'resolve', 'reopen', 'get', 'list'];\nconst valid_action = allowed.includes(action);\n\nconst p = { ...(body || {}), action };\np.ticket_id = String(body.ticket_id || '').trim();\np.ticket_number = String(body.ticket_number || '').trim();\n\nif (valid_action) {\n  if (['update', 'assign', 'resolve', 'reopen', 'get'].includes(action) && !p.ticket_id) {\n    p.validation_error = 'ticket_id_required';\n  }\n  if (action === 'create' && !p.subject) {\n    p.validation_error = 'subject_required';\n  }\n}\n\nreturn [{ json: p }];"
      },
      "id": "ticket-parse",
      "name": "Parse Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [260, 0]
    },

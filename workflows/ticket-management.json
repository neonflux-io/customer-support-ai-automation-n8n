    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH updated AS (UPDATE tickets SET assigned_to = NULLIF($2, ''), status = CASE WHEN status = 'open' THEN 'assigned' ELSE status END, updated_at = now() WHERE id = NULLIF($1, '')::uuid RETURNING ticket_number, id, assigned_to, status) SELECT * FROM updated UNION ALL SELECT 'NONE', NULL, NULL, NULL WHERE NOT EXISTS (SELECT 1 FROM updated);",
        "queryParameters": {
          "parameters": [
            { "value": "={{ $json.ticket_id }}" },

    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH found AS (SELECT ticket_number, id, customer_id, conversation_id, subject, status, priority, intent, confidence, sentiment, ai_summary, escalation_reason, assigned_to, resolution, last_message, created_at, updated_at FROM tickets WHERE id = NULLIF($1, '')::uuid OR ticket_number = NULLIF($2, '')) SELECT * FROM found UNION ALL SELECT 'NONE', NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL::numeric, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL WHERE NOT EXISTS (SELECT 1 FROM found);",

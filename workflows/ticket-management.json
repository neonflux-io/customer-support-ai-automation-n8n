    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH found AS (SELECT ticket_number, id, status, priority, intent, assigned_to, created_at FROM tickets WHERE NULLIF($1, '') IS NULL OR status = $1 ORDER BY created_at DESC LIMIT 100) SELECT * FROM found UNION ALL SELECT 'NONE', NULL, NULL, NULL, NULL, NULL, NULL WHERE NOT EXISTS (SELECT 1 FROM found);",
        "queryParameters": {

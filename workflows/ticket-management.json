        "query": "WITH updated AS (UPDATE tickets SET status = 'open', closed_at = NULL, resolved_at = NULL, updated_at = now() WHERE id = NULLIF($1, '')::uuid RETURNING ticket_number, id, status) SELECT * FROM updated UNION ALL SELECT 'NONE', NULL, NULL WHERE NOT EXISTS (SELECT 1 FROM updated);",

    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Format the query result; the 'NONE' marker row signals a missing ticket.\nconst rows = $input.all().map(i => i.json);\nif (rows.length === 1 && rows[0].ticket_number === 'NONE') {\n  return [{ json: { success: false, error: 'ticket_not_found' } }];\n}\nreturn [{ json: { success: true, data: rows } }];"
      },

    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH created AS (INSERT INTO tickets (customer_id, conversation_id, subject, status, priority, intent, confidence, sentiment, ai_summary, escalation_reason, assigned_to, last_message, metadata) VALUES (NULLIF($1, '')::uuid, NULLIF($2, '')::uuid, NULLIF($3, ''), NULLIF($4, ''), NULLIF($5, ''), NULLIF($6, ''), NULLIF($7, '')::numeric, NULLIF($8, ''), NULLIF($9, ''), NULLIF($10, ''), NULLIF($11, ''), NULLIF($12, ''), COALESCE(NULLIF($13, '')::jsonb, '{}'::jsonb)) RETURNING ticket_number, id, status, priority, subject, created_at) SELECT * FROM created;",
        "queryParameters": {
          "parameters": [
            { "value": "={{ $json.customer_id }}" },
            { "value": "={{ $json.conversation_id }}" },
            { "value": "={{ $json.subject }}" },
            { "value": "={{ $json.status || 'open' }}" },
            { "value": "={{ $json.priority }}" },
            { "value": "={{ $json.intent }}" },
            { "value": "={{ $json.confidence }}" },
            { "value": "={{ $json.sentiment }}" },
            { "value": "={{ $json.ai_summary }}" },
            { "value": "={{ $json.escalation_reason }}" },
            { "value": "={{ $json.assigned_to }}" },
            { "value": "={{ $json.last_message }}" },
            { "value": "={{ JSON.stringify($json.metadata || {}) }}" }
          ]
        },
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_POSTGRES_CREDENTIAL_ID",
          "name": "Postgres"
        }

# =====================================================================
# n8n AI Customer Support Automation - Environment configuration
# ---------------------------------------------------------------------
# Copy this file to .env and adjust values. n8n reads .env files that
# live in the n8n data directory (N8N_USER_FOLDER) or the process
# environment. Secrets such as API keys and database passwords must be
# stored in n8n Credentials; this file only carries non-secret tuning
# parameters plus the non-secret parts of connection strings.
#
# Never commit a real .env file. Only .env.example is tracked.
# =====================================================================

# ---------------------------------------------------------------------
# n8n host configuration
# ---------------------------------------------------------------------
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# ---------------------------------------------------------------------
# Sub-workflow base path
# Points to the workflows/subflows directory on the n8n host.
# Used by every "Execute Sub-workflow" node in customer-support.json.
# ---------------------------------------------------------------------
SUBWORKFLOW_BASE_PATH=/opt/n8n-ai-customer-support/workflows/subflows

# ---------------------------------------------------------------------
# Webhook
# ---------------------------------------------------------------------
WEBHOOK_PATH=customer-support

# ---------------------------------------------------------------------
# AI / LLM
# ---------------------------------------------------------------------
# OpenAI-compatible credentials are created inside n8n (Credential ->
# OpenAI API). The model names below can be overridden via env vars.
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------
# Thresholds - AI confidence & escalation
# ---------------------------------------------------------------------
# Intent/sentiment confidence below this value forces escalation.
AI_CONFIDENCE_THRESHOLD=0.6

# Refund amount (USD) at or above which a refund request requires manual
# approval and is escalated immediately.
REFUND_APPROVAL_THRESHOLD=100

# ---------------------------------------------------------------------
# Thresholds - RAG / knowledge retrieval
# ---------------------------------------------------------------------
# Number of chunks retrieved from pgvector.
RAG_TOP_K=4

# A retrieved chunk with a similarity score at or above this value counts
# as a STRONG hit -> automated grounded answer.
RAG_STRONG_THRESHOLD=0.5

# A retrieved chunk with a similarity score at or above this value counts
# as a WEAK hit -> clarification or escalation.
RAG_SIMILARITY_THRESHOLD=0.3

# ---------------------------------------------------------------------
# Context / conversation memory
# ---------------------------------------------------------------------
# Maximum recent messages injected into the LLM context window.
CONTEXT_MESSAGE_LIMIT=10

# When the loaded recent-message window is at least this size, the memory
# sub-workflow summarizes the conversation automatically.
CONTEXT_SUMMARIZE_THRESHOLD=8

# ---------------------------------------------------------------------
# Response validation
# ---------------------------------------------------------------------
RESPONSE_MIN_LENGTH=5
RESPONSE_MAX_LENGTH=500

# Regeneration attempts before escalating. The main workflow performs a
# single automatic regeneration, so keep this at 1.
RETRY_LIMIT=1

# ---------------------------------------------------------------------
# Knowledge base ingestion
# ---------------------------------------------------------------------
# Optional URL fetched by knowledge-base-ingestion.json when the webhook
# body does not include documents.
KB_SOURCE_URL=

# Chunking parameters used by the ingestion workflow.
KB_CHUNK_SIZE=800
KB_CHUNK_OVERLAP=100

# ---------------------------------------------------------------------
# PostgreSQL (used by docker-compose / local setup and to document the
# expected values in the n8n Postgres credential)
# ---------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_customer_support
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me
